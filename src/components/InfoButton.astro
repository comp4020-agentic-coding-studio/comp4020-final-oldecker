---
// A small, low-contrast "(i)" button that hides a standing explanation
// until someone asks for it, instead of showing a paragraph of prose to
// everyone, always. Click/tap toggles a popover next to the button; it
// never relies on hover (this is used on phones), and a real <button> with
// aria-expanded + aria-describedby keeps it keyboard- and screen-reader-
// reachable. Esc and an outside click close it (src/scripts/info-button.ts
// wires every instance on the page up by delegation, so adding a sixth one
// here needs no new JS).
//
// Usage: <InfoButton id="corridor-info" label="about the corridor">
//   who's in the house right now...
// </InfoButton>
interface Props {
  id: string;
  label?: string;
}
const { id, label = "what's this?" } = Astro.props;
const popId = `${id}-pop`;
---

<span class="info-wrap">
  <button
    type="button"
    id={id}
    class="info-btn"
    aria-expanded="false"
    aria-controls={popId}
    aria-describedby={popId}
    aria-label={label}
    data-info-btn
  >
    <svg viewBox="0 0 16 16" aria-hidden="true" class="info-icon">
      <circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1.3" />
      <circle cx="8" cy="4.9" r="0.95" fill="currentColor" />
      <path d="M8 7.3 V11.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    </svg>
  </button>
  <span class="info-pop" id={popId} role="note" hidden>
    <slot />
  </span>
</span>

<style>
  .info-wrap {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
  }
  .info-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    flex: none;
  }
  .info-btn:hover,
  .info-btn:focus-visible {
    border-color: var(--text-muted);
    color: var(--ink);
  }
  .info-btn[aria-expanded="true"] {
    background: var(--border);
    color: var(--ink);
  }
  .info-icon {
    width: 0.68rem;
    height: 0.68rem;
  }
  .info-pop {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.35rem);
    /* left is set inline by info-button.ts once it's shown, clamped so the
       popover never runs off either edge of the viewport; this left: 0 is
       just the layout fallback before JS measures it */
    left: 0;
    width: max-content;
    max-width: min(20rem, 72vw);
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--card);
    color: var(--ink);
    font-size: 0.78rem;
    line-height: 1.4;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }
  .info-pop[hidden] {
    display: none;
  }
</style>

<script src="../scripts/info-button.ts" />
