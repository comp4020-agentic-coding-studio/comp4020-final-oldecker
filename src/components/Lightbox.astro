---
// The full-screen photo viewer. One static, hidden dialog per page; every
// post thumbnail is a `.post-photo` button carrying data-full, and
// src/scripts/lightbox.ts listens on document (not per image), so a post
// that arrives or re-renders after load opens here too. Display-only: it
// reads the same /uploads/ URL the thumbnail already shows and never
// writes anything.
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="photo viewer" hidden>
  <figure class="lb-stage">
    <img class="lb-img" alt="" />
  </figure>
  <p class="lb-count" aria-live="polite"></p>
  <button type="button" class="lb-btn lb-close" aria-label="close photo">✕</button>
  <button type="button" class="lb-btn lb-prev" aria-label="previous photo">‹</button>
  <button type="button" class="lb-btn lb-next" aria-label="next photo">›</button>
</div>
<script src="../scripts/lightbox.ts"></script>

<style>
  /* the backdrop is always a near-black dim regardless of mode --- a photo
     reads best against dark, and --bg would wash light photos out. The
     controls sit on --card/--ink so they still follow the app's theme. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, #000 82%, transparent);
    touch-action: none;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-stage {
    margin: 0;
    width: 100vw;
    height: 100dvh;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  /* explicit viewport caps, not 100% --- a percentage max-height inside an
     auto-sized grid row doesn't resolve, and a tall photo spilled off-screen.
     3.5rem top/bottom clears the counter, close button and phone arrows. */
  .lb-img {
    max-width: calc(100vw - 1.5rem);
    max-height: calc(100dvh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.4rem;
    pointer-events: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  .lb-count {
    position: fixed;
    top: 0.9rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .lb-count:empty {
    display: none;
  }
  .lb-btn {
    position: fixed;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .lb-btn:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .lb-btn[hidden] {
    display: none;
  }
  .lb-close {
    top: 0.6rem;
    right: 0.6rem;
    font-size: 1.1rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 0.6rem;
  }
  .lb-next {
    right: 0.6rem;
  }
  /* phones: arrows move to the bottom edge so they don't sit on the photo */
  @media (max-width: 600px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.6rem;
      transform: none;
    }
  }
</style>
