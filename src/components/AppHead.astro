---
// Tags every page's <head> carries so the board can be added to a phone's
// home screen as an app (public/manifest.webmanifest). On iPhone that's not
// cosmetic: Safari only lets a home-screen web app ask for notifications.
---

<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" type="image/png" href="/icons/icon-192.png" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="theme-color" content="#e88a5a" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="the board" />
