---
// The root URL. Logged out: the landing card (a 200, which is what
// spec/invariants.test.ts and the deploy check read --- they fetch with no
// cookie). Logged in: straight to the house you last opened, or out to the
// street (/houses) if you don't have one yet.
import "../styles/tokens.css";
import { lastHouseFor } from "../lib/houses";
import { currentPerson } from "../lib/identity";

export const prerender = false;

const person = currentPerson(Astro.cookies);
if (person) {
  const last = lastHouseFor(person.id);
  return Astro.redirect(last ? `/h/${encodeURIComponent(last.slug)}` : "/houses");
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>the board</title>
    <style>
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem 1rem 4rem;
      }
      .landing {
        display: grid;
        gap: 0.8rem;
        max-width: 320px;
        margin: 3rem auto;
        text-align: center;
      }
      .landing p {
        margin: 0;
        opacity: 0.7;
      }
      .landing-actions {
        display: grid;
        gap: 0.6rem;
        margin-top: 0.6rem;
      }
      .landing-actions a {
        padding: 0.6rem 1.2rem;
        border-radius: 999px;
        border: 1px solid var(--ink);
        color: var(--ink);
        text-decoration: none;
      }
      .landing-actions a.primary {
        background: var(--ink);
        color: var(--bg);
      }
    </style>
  </head>
  <body>
    <main>
      <section class="landing">
        <h1>the board</h1>
        <p>A little shared space for the group. Log in, or make an account if you're new.</p>
        <div class="landing-actions">
          <a class="primary" href="/signup">sign up</a>
          <a href="/login">log in</a>
        </div>
      </section>
    </main>
  </body>
</html>
