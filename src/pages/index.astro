---
import { desc, eq, isNull } from "drizzle-orm";
import { db } from "../lib/db";
import { COLORS, currentPerson } from "../lib/identity";
import { plantHealth } from "../lib/plant";
import { people, postImages, postScores, posts } from "../lib/schema";
import { emojiForScore, median, SCORE_MAX, SCORE_MIN, scoreToY } from "../lib/temperature";

const person = currentPerson(Astro.cookies);
const sort = Astro.url.searchParams.get("sort") === "extreme" ? "extreme" : "new";

const feed = person
  ? db
      .select({
        id: posts.id,
        category: posts.category,
        body: posts.body,
        createdAt: posts.createdAt,
        authorName: people.name,
        authorColor: people.color,
      })
      .from(posts)
      .innerJoin(people, eq(posts.authorId, people.id))
      .where(isNull(posts.archivedAt))
      // id as a tiebreaker: createdAt is second-resolution, so two posts in
      // the same second would otherwise sort arbitrarily against each other
      .orderBy(desc(posts.createdAt), desc(posts.id))
      .all()
  : [];

const images = person
  ? Object.fromEntries(
      feed.map((post) => [
        post.id,
        db
          .select({ path: postImages.path })
          .from(postImages)
          .where(eq(postImages.postId, post.id))
          .orderBy(postImages.position)
          .all()
          .map((row) => row.path),
      ]),
    )
  : {};

// Every individual vote, grouped by post --- the raw material for the
// median/strip-plot display and for "extremest" sorting. Never rendered as
// a list of numbers anywhere (see the strip plot below): this is read once,
// here, to derive the two aggregates that ARE shown.
const scoresByPost: Record<number, number[]> = {};
for (const row of db.select({ postId: postScores.postId, score: postScores.score }).from(postScores).all())
  (scoresByPost[row.postId] ??= []).push(row.score);

// "extremest" sorts on the group's average lean (|avg score|), not any one
// person's vote --- how strongly the room has landed towards 🔥 or ❄️
// overall, regardless of direction. Computed at read time, same as the
// plant's health: no stored aggregate to keep in sync.
const avgOf = (scores: number[] | undefined) =>
  scores?.length ? scores.reduce((a, b) => a + b, 0) / scores.length : 0;

// Each visitor's own existing vote (if any), so returning to the board
// shows your slider where you left it rather than snapping back to neutral.
const myScores = person
  ? Object.fromEntries(
      db
        .select({ postId: postScores.postId, score: postScores.score })
        .from(postScores)
        .where(eq(postScores.personId, person.id))
        .all()
        .map((row) => [row.postId, row.score]),
    )
  : {};

if (sort === "extreme")
  feed.sort((a, b) => Math.abs(avgOf(scoresByPost[b.id])) - Math.abs(avgOf(scoresByPost[a.id])));

// The strip plot's own scale: a vertical pixel height the rotated slider's
// track length has to match exactly (see the CSS below) so the group's
// votes and your own thumb read as one shared axis.
const STRIP_H = 96;
const STRIP_W = 20;

// Everything a post's template fragment needs, precomputed here rather than
// inside the template: Astro's template compiler doesn't accept a
// block-bodied arrow (`.map(x => { const ...; return (...) })`) the way
// plain TSX does, so per-post derivation lives in the frontmatter and the
// template below stays a single-expression `.map`.
const feedView = feed.map((post) => {
  const scores = scoresByPost[post.id] ?? [];
  const med = median(scores);
  // group near-identical scores so their dots don't fully overlap --- a
  // small, deterministic jitter, not a statistical one
  const seen = new Map<number, number>();
  const dots = scores.map((s) => {
    const bucket = Math.round(s / 8);
    const i = seen.get(bucket) ?? 0;
    seen.set(bucket, i + 1);
    const color = s === 0 ? "var(--temp-neutral-ink)" : s > 0 ? "var(--temp-hot)" : "var(--temp-cold)";
    return { x: STRIP_W / 2 + ((i % 3) - 1) * 5, y: scoreToY(s, STRIP_H), color };
  });
  const stripLabel =
    scores.length === 0
      ? "no one has rated this post yet"
      : `group rating: ${scores.length} vote${scores.length === 1 ? "" : "s"}, median ${emojiForScore(med ?? 0)}`;
  const medianY = med === null ? null : scoreToY(med, STRIP_H);
  const medianEmoji = med === null ? "–" : emojiForScore(med);
  const medianTitle = med === null ? "no votes yet" : `median: ${Math.round(med)}`;
  return { ...post, dots, stripLabel, medianY, medianEmoji, medianTitle, myScore: myScores[post.id] ?? 0 };
});

const health = person ? plantHealth() : null;

const CATEGORY_LABEL: Record<string, string> = {
  emotional: "feeling",
  practical: "doing",
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>the board</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #faf7f2;
        --ink: #2b2420;
        --card: #ffffff;
        --border: #e8e0d6;
        --text-muted: #898781;
        /* diverging pair for the temperature strip/slider --- dataviz skill's
           validated default (blue<->red), re-validated against this app's
           own --card surfaces (both modes pass all six checks) */
        --temp-cold: #2a78d6;
        --temp-hot: #e34948;
        --temp-neutral-ink: #898781;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1c1815;
          --ink: #f1ebe3;
          --card: #262019;
          --border: #3a332a;
          --text-muted: #898781;
          --temp-cold: #3987e5;
          --temp-hot: #e66767;
          --temp-neutral-ink: #898781;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        line-height: 1.5;
      }
      main {
        max-width: 640px;
        margin: 0 auto;
        padding: 1.5rem 1rem 4rem;
      }

      /* --- the plant ------------------------------------------------- */
      .plant-widget {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: var(--card);
        margin-bottom: 1.5rem;
      }
      /* stage affects the plant itself (growth); "just-watered" bumps the
         wrapping element so the two transforms never fight over one box. */
      #plant {
        transition: transform 0.3s ease;
      }
      #plant.just-watered {
        transform: scale(1.1);
      }
      #plant svg {
        width: 72px;
        height: 72px;
        transition: transform 0.4s ease;
        transform-origin: bottom center;
      }
      #plant[data-stage="wilting"] .leaf {
        stroke: #a88b5a;
        fill: #d8c9a3;
      }
      #plant[data-stage="thirsty"] .leaf {
        stroke: #8a9b5e;
        fill: #c3cf97;
      }
      #plant[data-stage="okay"] .leaf {
        stroke: #5c8a4a;
        fill: #9ccb7e;
      }
      #plant[data-stage="thriving"] .leaf {
        stroke: #3f6b32;
        fill: #7fc45c;
      }
      /* the plant visibly grows across stages, not just changes colour */
      #plant[data-stage="wilting"] svg {
        transform: scale(0.8) rotate(-6deg);
      }
      #plant[data-stage="thirsty"] svg {
        transform: scale(0.92);
      }
      #plant[data-stage="okay"] svg {
        transform: scale(1.04);
      }
      #plant[data-stage="thriving"] svg {
        transform: scale(1.2);
      }
      .plant-info {
        flex: 1;
      }
      .plant-info h2 {
        margin: 0 0 0.2rem;
        font-size: 1rem;
      }
      #plant-stage {
        font-size: 0.85rem;
        opacity: 0.7;
      }

      /* --- the watering can -------------------------------------------- */
      #water-can {
        position: relative;
        border: none;
        background: none;
        cursor: pointer;
        padding: 0.5rem;
        color: var(--ink);
        line-height: 1;
        transition: transform 0.15s ease;
      }
      #water-can:active {
        transform: scale(0.9);
      }
      .can-icon {
        width: 2.6rem;
        height: 2rem;
        display: block;
        transform-origin: 85% 70%; /* roughly the base of the can, not its spout tip */
        transition: transform 0.15s ease;
      }
      #water-can.pouring .can-icon {
        animation: pour 0.7s ease;
      }
      @keyframes pour {
        0% {
          transform: rotate(0deg);
        }
        /* positive = clockwise: the spout (upper-right of the icon) swings
           further right and dips down, towards the pivot at bottom-right
           (transform-origin above) --- a lean to the right, tipping forward
           to pour, not away from it. */
        30% {
          transform: rotate(35deg);
        }
        70% {
          transform: rotate(35deg);
        }
        100% {
          transform: rotate(0deg);
        }
      }
      /* anchored roughly under where the spout tip swings to mid-pour
         (further right and lower than its resting position, now that the
         can leans right --- see the `pour` keyframes above) */
      .drop {
        position: absolute;
        top: 0.45rem;
        right: 0.15rem;
        width: 5px;
        height: 7px;
        border-radius: 0 50% 50% 50%;
        background: #6fa8d8;
        opacity: 0;
        transform: rotate(45deg); /* shape only: turns the circle into a teardrop */
      }
      .drop:nth-of-type(2) {
        right: 0.35rem;
      }
      .drop:nth-of-type(3) {
        right: -0.05rem;
      }
      #water-can.pouring .drop {
        animation: drip 0.7s ease calc(var(--i) * 0.1s + 0.15s);
      }
      /* translateY listed before (outer to) rotate(45deg): the fall is a
         straight screen-space displacement, with the teardrop's own shape
         rotation applied first and not carried into the fall direction.
         (the reverse order --- rotate() outer --- was rotating the actual
         translateY displacement by 45°, so the drop fell diagonally
         instead of straight down.) */
      @keyframes drip {
        0% {
          opacity: 0;
          transform: translateY(0) rotate(45deg);
        }
        30% {
          opacity: 1;
        }
        90% {
          opacity: 0.8;
        }
        100% {
          opacity: 0;
          transform: translateY(16px) rotate(45deg);
        }
      }

      /* --- composer ---------------------------------------------------- */
      #compose-form {
        display: grid;
        gap: 0.6rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: var(--card);
        margin-bottom: 2rem;
      }
      #compose-form textarea {
        resize: vertical;
        min-height: 4rem;
        font: inherit;
        padding: 0.5rem;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        background: transparent;
        color: inherit;
      }
      #compose-form select,
      #compose-form input[type="file"] {
        font: inherit;
      }
      #compose-form button {
        justify-self: start;
        padding: 0.5rem 1.2rem;
        border-radius: 999px;
        border: none;
        background: var(--ink);
        color: var(--bg);
        font: inherit;
        cursor: pointer;
      }

      /* --- feed ---------------------------------------------------------- */
      .post {
        display: flex;
        align-items: stretch;
        gap: 0.75rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: var(--card);
        margin-bottom: 1rem;
      }
      .post-main {
        flex: 1;
        min-width: 0; /* so a long image row/caption can't push the temp column off */
      }
      .post header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.4rem;
        font-size: 0.85rem;
      }
      .avatar {
        width: 1.4rem;
        height: 1.4rem;
        border-radius: 50%;
        display: inline-block;
      }
      .category-tag {
        opacity: 0.8;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.75rem;
      }
      /* feeling vs doing: a colour, not just a label */
      .category-emotional {
        background: #f3dde3;
        color: #8a3d53;
      }
      .category-practical {
        background: #dde7f3;
        color: #2f5a8a;
      }
      @media (prefers-color-scheme: dark) {
        .category-emotional {
          background: #4a2530;
          color: #f0c3d1;
        }
        .category-practical {
          background: #203349;
          color: #bcd6f5;
        }
      }

      .sort-toggle {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
      }
      .sort-toggle a {
        color: inherit;
        opacity: 0.5;
        text-decoration: none;
      }
      .sort-toggle a[aria-current="page"] {
        opacity: 1;
        font-weight: 600;
        text-decoration: underline;
      }

      /* --- the ❄️<->🔥 slider, on the side of the post -------------------
         A vertical slider (a horizontal <input> rotated -90deg) overlaid on
         an SVG strip plot sharing the exact same length/scale, so the
         group's votes and your own thumb sit on one visual axis: top =
         SCORE_MAX (🔥), bottom = SCORE_MIN (❄️) --- see scoreToY() in
         src/lib/temperature.ts, which this layout has to agree with. */
      .post-temp {
        flex: none;
        width: 2.75rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        padding-top: 0.1rem;
      }
      .temp-emoji {
        font-size: 1.1rem;
        line-height: 1;
      }
      .temp-stack {
        position: relative;
      }
      .temp-strip {
        position: absolute;
        inset: 0;
        pointer-events: none; /* decoration behind the slider, never blocks the drag */
      }
      .temp-median-tick {
        stroke: var(--text-muted);
        stroke-width: 2;
        stroke-linecap: round;
      }
      .temp-slider-wrap {
        position: absolute;
        top: 50%;
        left: 50%;
        height: 8px; /* the rotated track's thickness */
        transform: translate(-50%, -50%) rotate(-90deg);
      }
      .temp-slider {
        display: block;
        width: 100%;
        height: 100%;
        margin: 0;
        -webkit-appearance: none;
        appearance: none;
        background: linear-gradient(
          to right,
          var(--temp-cold),
          var(--border) 48%,
          var(--border) 52%,
          var(--temp-hot)
        );
        border-radius: 999px;
        outline: none;
      }
      .temp-median-label {
        font-size: 0.95rem;
        line-height: 1;
        opacity: 0.8;
        cursor: default;
      }
      .temp-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--card);
        border: 2px solid var(--ink);
        cursor: grab;
      }
      .temp-slider::-moz-range-thumb {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--card);
        border: 2px solid var(--ink);
        cursor: grab;
      }
      .temp-slider:active::-webkit-slider-thumb,
      .temp-slider:active::-moz-range-thumb {
        cursor: grabbing;
      }
      .post p {
        margin: 0 0 0.5rem;
        white-space: pre-wrap;
      }
      .post-images {
        display: flex;
        gap: 0.4rem;
      }
      .post-images img {
        width: 96px;
        height: 96px;
        object-fit: cover;
        border-radius: 0.6rem;
      }
      time {
        opacity: 0.5;
        font-size: 0.75rem;
      }

      /* --- join form ------------------------------------------------- */
      .join {
        display: grid;
        gap: 0.8rem;
        max-width: 320px;
        margin: 3rem auto;
        text-align: center;
      }
      .colors {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
      }
      .colors label {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        cursor: pointer;
        display: inline-block;
        border: 2px solid transparent;
      }
      .colors input {
        display: none;
      }
      .colors input:checked + label {
        border-color: var(--ink);
      }
    </style>
  </head>
  <body>
    <main>
      {
        !person ? (
          <form class="join" method="post" action="/api/join">
            <h1>pick a name and a colour</h1>
            <input name="name" placeholder="your name" maxlength="40" required autofocus />
            <div class="colors">
              {COLORS.map((c, i) => (
                <>
                  <input type="radio" name="color" id={`c${i}`} value={c} checked={i === 0} />
                  <label for={`c${i}`} style={`background:${c}`} />
                </>
              ))}
            </div>
            <button type="submit">join the board</button>
          </form>
        ) : (
          <>
            <div class="plant-widget">
              <button id="water-can" aria-label="water the plant" data-threshold={health?.threshold}>
                <svg class="can-icon" viewBox="0 0 64 48" aria-hidden="true">
                  <rect x="8" y="16" width="28" height="20" rx="6" fill="currentColor" />
                  <path
                    d="M13 16 C13 6 31 6 31 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <path
                    d="M34 22 L54 10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="5"
                    stroke-linecap="round"
                  />
                  <circle cx="56" cy="8" r="4" fill="currentColor" />
                </svg>
                <span class="drop" style="--i: 0" />
                <span class="drop" style="--i: 1" />
                <span class="drop" style="--i: 2" />
              </button>
              <div id="plant" data-stage={health?.stage}>
                <svg viewBox="0 0 64 64" aria-hidden="true">
                  <path
                    class="leaf"
                    d="M32 58 C32 40 32 30 32 20 M32 20 C20 20 12 10 12 4 C22 4 32 12 32 24 M32 24 C44 24 52 14 52 6 C40 6 32 16 32 28"
                    fill="none"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <rect x="22" y="54" width="20" height="8" rx="2" class="leaf" stroke-width="2" />
                </svg>
              </div>
              <div class="plant-info">
                <h2>the plant</h2>
                <p id="plant-stage">
                  {health?.waterersThisWeek} of {health?.threshold} this week
                </p>
              </div>
            </div>

            <form id="compose-form" method="post" action="/api/posts" enctype="multipart/form-data">
              <select name="category" required>
                <option value="emotional">feeling</option>
                <option value="practical">doing</option>
              </select>
              <textarea name="body" placeholder="a little update..." required maxlength="2000" />
              <input type="file" name="images" accept="image/*" multiple />
              <button type="submit">post</button>
            </form>

            <div class="sort-toggle">
              <a href="/" aria-current={sort === "new" ? "page" : undefined}>
                newest
              </a>
              <a href="/?sort=extreme" aria-current={sort === "extreme" ? "page" : undefined}>
                extremest 🔥❄️
              </a>
            </div>

            {feedView.map((post) => (
              <article class="post">
                <div class="post-main">
                  <header>
                    <span class="avatar" style={`background:${post.authorColor}`} />
                    <strong>{post.authorName}</strong>
                    <span class={`category-tag category-${post.category}`}>
                      {CATEGORY_LABEL[post.category] ?? post.category}
                    </span>
                    <time>{new Date(post.createdAt * 1000).toLocaleDateString()}</time>
                  </header>
                  <p>{post.body}</p>
                  {images[post.id]?.length > 0 && (
                    <div class="post-images">
                      {images[post.id].map((path) => (
                        <img src={`/uploads/${path}`} alt="" loading="lazy" />
                      ))}
                    </div>
                  )}
                </div>

                <div class="post-temp">
                  <span class="temp-emoji" aria-hidden="true">
                    {emojiForScore(post.myScore)}
                  </span>
                  <div class="temp-stack" style={`width:${STRIP_W}px;height:${STRIP_H}px`}>
                    <svg
                      class="temp-strip"
                      viewBox={`0 0 ${STRIP_W} ${STRIP_H}`}
                      width={STRIP_W}
                      height={STRIP_H}
                      role="img"
                      aria-label={post.stripLabel}
                    >
                      {post.dots.map((d) => (
                        <circle cx={d.x} cy={d.y} r="4" fill={d.color} stroke="var(--card)" stroke-width="2" />
                      ))}
                      {post.medianY !== null && (
                        <line
                          x1="1"
                          y1={post.medianY}
                          x2={STRIP_W - 1}
                          y2={post.medianY}
                          class="temp-median-tick"
                        />
                      )}
                    </svg>
                    <div class="temp-slider-wrap" style={`width:${STRIP_H}px`}>
                      <input
                        type="range"
                        class="temp-slider"
                        data-post-id={post.id}
                        min={SCORE_MIN}
                        max={SCORE_MAX}
                        step="1"
                        value={post.myScore}
                        aria-label={`rate this post from freezing to on fire; ${post.stripLabel}`}
                      />
                    </div>
                  </div>
                  <span class="temp-median-label" title={post.medianTitle}>
                    {post.medianEmoji}
                  </span>
                </div>
              </article>
            ))}
          </>
        )
      }
    </main>
    {person && (
      <>
        <script src="../scripts/water-plant.ts" />
        <script src="../scripts/compress-image.ts" />
        <script src="../scripts/temperature-slider.ts" />
      </>
    )}
  </body>
</html>
