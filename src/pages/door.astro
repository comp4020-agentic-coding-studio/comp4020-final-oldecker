---
// What /h/<slug> shows a logged-in non-member (403) or for a house that
// doesn't exist (404), via Astro.rewrite --- the URL stays /h/<slug>.
// Deliberately carries nothing from inside the house: no posts, no members,
// no presence. "Come in" is the same join-by-name a person could do from
// the street page's signpost, so it opens nothing that wasn't already open
// to anyone who knows the name.
import DoorLayout from "../layouts/DoorLayout.astro";
import { houseBySlug, isMember } from "../lib/houses";
import { currentPerson } from "../lib/identity";

export const prerender = false;

const slug = Astro.url.searchParams.get("house") ?? "";
const person = currentPerson(Astro.cookies);
if (!person) return Astro.redirect("/login");
const house = slug ? houseBySlug(slug) : undefined;
// Visited directly while actually a member: there's nothing to knock on.
if (house && isMember(house.id, person.id)) return Astro.redirect(`/h/${encodeURIComponent(house.slug)}`);
Astro.response.status = house ? 403 : 404;
---

<DoorLayout title={house ? house.name : "no such house"} paint={house?.id ?? 3}>
  {
    house ? (
      <>
        <h1>{house.name}</h1>
        <p>You're not a member of this house yet, so its door is shut.</p>
        <form method="post" action="/api/houses/join">
          <input type="hidden" name="name" value={house.slug} />
          <button type="submit">come in</button>
        </form>
        <a class="door-link secondary" href="/houses">back to the street</a>
      </>
    ) : (
      <>
        <h1>there's no house here</h1>
        <p>Nobody has built a house called "{slug}" yet.</p>
        <a class="door-link secondary" href="/houses">back to the street</a>
      </>
    )
  }
</DoorLayout>
